# EXEMPLO INERTE: placeholders devem ser substituidos pelo cofre do ambiente.
# Arquivo real fora do Git, com acesso restrito. Nao executar como script shell.
CP_API_IMAGE=REGISTRY/condpulse-api@sha256:SET_APPROVED_DIGEST
CP_WEB_IMAGE=REGISTRY/condpulse-web@sha256:SET_APPROVED_DIGEST
CP_API_DATABASE_URL=jdbc:postgresql://DB_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
CP_API_DATABASE_USER=SET_IN_VAULT
CP_API_DATABASE_PASSWORD=SET_IN_VAULT
CP_SUPABASE_URL=https://PROJECT_REF.supabase.co
CP_BFF_ORIGIN=https://SET_WEB_DOMAIN
CP_DB_CA_FILE=/etc/condpulse/ca/postgres.crt
CP_PROXY_NETWORK=SET_CONDPULSE_PROXY_NETWORK
