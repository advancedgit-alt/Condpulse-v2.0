# EXEMPLO INERTE: placeholders devem ser substituidos pelo cofre do ambiente.
# Arquivo real fora do Git, com acesso restrito. Nao executar como script shell.
CP_API_IMAGE=REGISTRY/condpulse-api@sha256:SET_APPROVED_DIGEST
CP_WORKER_DATABASE_URL=jdbc:postgresql://DB_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
CP_WORKER_DATABASE_USER=SET_IN_VAULT
CP_WORKER_DATABASE_PASSWORD=SET_IN_VAULT
CP_DB_CA_FILE=/etc/condpulse/ca/postgres.crt
