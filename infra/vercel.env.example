# EXEMPLO INERTE. Variaveis server-only no projeto/ambiente Vercel CondPulse.
# Nunca usar prefixo VITE_, NEXT_PUBLIC_ ou credencial DDL/onboarding nesta lista.
# PORT deve ser cadastrado nas configuracoes Vercel para a porta do Container Runtime.
PORT=8080
DB_POOL_SIZE=2
DATABASE_URL=jdbc:postgresql://DB_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/tmp/condpulse-db-ca.crt
DATABASE_USER=SET_CP_RUNTIME_IDENTITY_IN_VAULT
DATABASE_PASSWORD=SET_IN_VAULT
CP_VERCEL_DB_CA_BASE64=SET_BASE64_OF_VALIDATED_PUBLIC_POSTGRES_CA
CP_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
CP_JWT_JWK_SET_URI=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Usar alias HTTPS estavel vercel.app; previews mutaveis nao alteram esta origem.
CP_BFF_ORIGIN=https://SET_STABLE_CONDPULSE_ALIAS.vercel.app
# Preparar chaves conforme docs/CONFIGURACAO_BFF.md mantendo flags false.
# Ativacao controlada para ensaiar Auth no alvo de homologacao; uso real so apos gates.
CP_BFF_ENABLED=false
CP_RESERVATIONS_ENABLED=false
CP_SUPABASE_PUBLISHABLE_KEY=SET_PROJECT_PUBLISHABLE_KEY_IN_VAULT
CP_BFF_ENCRYPTION_KEY=SET_RANDOM_32_BYTE_BASE64_KEY_IN_VAULT
CP_BFF_RATE_LIMIT_KEY=SET_DISTINCT_RANDOM_32_BYTE_BASE64_KEY_IN_VAULT
CP_BFF_SESSION_HOURS=8
