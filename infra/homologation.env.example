# EXEMPLO INERTE. Ambiente isolado, acesso restrito, dados sinteticos.
# Todos os valores reais vem do cofre. Nao executar como script shell.
CP_API_IMAGE=REGISTRY/condpulse-api@sha256:SET_APPROVED_DIGEST
CP_WEB_IMAGE=REGISTRY/condpulse-web@sha256:SET_APPROVED_DIGEST
CP_API_DATABASE_URL=jdbc:postgresql://DB_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
CP_API_DATABASE_USER=SET_RUNTIME_IDENTITY_IN_VAULT
CP_API_DATABASE_PASSWORD=SET_IN_VAULT
CP_SUPABASE_URL=https://HOMOLOGATION_PROJECT_REF.supabase.co
CP_BFF_ORIGIN=https://SET_HOMOLOGATION_DOMAIN
CP_SUPABASE_PUBLISHABLE_KEY=SET_PROJECT_PUBLISHABLE_KEY_IN_VAULT
CP_BFF_ENCRYPTION_KEY=SET_RANDOM_32_BYTE_BASE64_KEY_IN_VAULT
CP_BFF_RATE_LIMIT_KEY=SET_INDEPENDENT_RANDOM_32_BYTE_BASE64_KEY_IN_VAULT
CP_DB_CA_FILE=/etc/condpulse-hml/ca/postgres.crt
CP_PROXY_NETWORK=condpulse-hml-SET_DEDICATED_PROXY_NETWORK
