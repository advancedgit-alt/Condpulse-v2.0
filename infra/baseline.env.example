# EXEMPLO INERTE; somente a excecao ADR-0003 do projeto indicado no manifesto.
# Build --target baseline usa a mesma revisao da API, mas tem digest proprio.
# Arquivo real fora do Git, fornecido pelo cofre. Nunca importar na aplicacao.
CP_BASELINE_IMAGE=REGISTRY/condpulse-baseline@sha256:SET_APPROVED_DIGEST
CP_MIGRATION_DATABASE_URL=jdbc:postgresql://db.rpnrqfrfwywglvyykgrg.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
CP_MIGRATION_DATABASE_USER=SET_DDL_IDENTITY_IN_VAULT
CP_MIGRATION_DATABASE_PASSWORD=SET_IN_VAULT
CP_DB_CA_FILE=/etc/condpulse/ca/postgres.crt
# Inspect e o padrao, inclusive com ACK preenchido. Nao inventar fingerprint.
# A operacao baseline separada exige rpnrqfrfwywglvyykgrg:002:FINGERPRINT_ATUAL_64_HEX.
CP_BASELINE_ACK=
