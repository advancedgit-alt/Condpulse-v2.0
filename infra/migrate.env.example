# EXEMPLO INERTE: credenciais exclusivas do job; nunca importar na API/web.
# CP_API_IMAGE precisa coincidir com o digest API da mesma release.
CP_API_IMAGE=REGISTRY/condpulse-api@sha256:SET_APPROVED_DIGEST
CP_MIGRATION_DATABASE_URL=jdbc:postgresql://DB_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt
CP_MIGRATION_DATABASE_USER=SET_DDL_IDENTITY_IN_VAULT
CP_MIGRATION_DATABASE_PASSWORD=SET_IN_VAULT
CP_DB_CA_FILE=/etc/condpulse/ca/postgres.crt
