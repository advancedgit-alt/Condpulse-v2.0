{
  "problemMatcher": [
    { "owner": "cp-javac", "severity": "error",
      "pattern": [{ "regexp": "^\\[ERROR\\] (?:/home/runner/work/[^/]+/[^/]+/)?(.+\\.java):\\[(\\d+),(\\d+)\\] (.+)$", "file": 1, "line": 2, "column": 3, "message": 4 }] },
    { "owner": "cp-javac-detail", "severity": "warning",
      "pattern": [{ "regexp": "^\\s+((?:symbol|location|required|found|reason):\\s+.+)$", "message": 1 }] },
    { "owner": "cp-maven", "severity": "error",
      "pattern": [{ "regexp": "^\\[ERROR\\] (?!/home/runner/)(?!\\s*$)(?!-> )(?!Re-run Maven)(?!To see the full)(?!For more information)(?!Help 1)(.+)$", "message": 1 }] },
    { "owner": "cp-java-exception", "severity": "warning",
      "pattern": [{ "regexp": "^((?:Caused by: )?(?:org\\.opentest4j|org\\.junit|org\\.postgresql|org\\.springframework|java\\.lang|java\\.sql|java\\.util|jakarta)\\.[\\w.$]*(?:Exception|Error|Failure)\\b.*)$", "message": 1 }] },
    { "owner": "cp-node-test", "severity": "error",
      "pattern": [{ "regexp": "^\\s*not ok \\d+ - (.+)$", "message": 1 }] },
    { "owner": "cp-node-test-detail", "severity": "warning",
      "pattern": [{ "regexp": "^\\s+(?:error|expected|actual|location): (.+)$", "message": 1 }] },
    { "owner": "cp-vitest", "severity": "error",
      "pattern": [{ "regexp": "^\\s*(FAIL\\s+\\S.+)$", "message": 1 }] },
    { "owner": "cp-js-assertion", "severity": "warning",
      "pattern": [{ "regexp": "^\\s*((?:AssertionError|TypeError|ReferenceError|SyntaxError)(?: \\[[A-Z_]+\\])?: .+)$", "message": 1 }] },
    { "owner": "cp-playwright", "severity": "error",
      "pattern": [{ "regexp": "^\\s+\\d+\\) \\[chromium\\] › (.+)$", "message": 1 }] },
    { "owner": "cp-playwright-detail", "severity": "warning",
      "pattern": [{ "regexp": "^\\s+(Error: (?:expect|page|locator|Timed out).+)$", "message": 1 }] },
    { "owner": "cp-tsc", "severity": "error",
      "pattern": [{ "regexp": "^(.+\\.tsx?)\\((\\d+),(\\d+)\\): error (TS\\d+: .+)$", "file": 1, "line": 2, "column": 3, "message": 4 }] },
    { "owner": "cp-python-unittest", "severity": "error",
      "pattern": [{ "regexp": "^((?:FAIL|ERROR): test\\S* \\(.+\\))$", "message": 1 }] },
    { "owner": "cp-python-detail", "severity": "warning",
      "pattern": [{ "regexp": "^((?:AssertionError|psycopg\\.\\S+|subprocess\\.CalledProcessError|RuntimeError|ValueError)(?::.*)?)$", "message": 1 }] },
    { "owner": "cp-psql", "severity": "error",
      "pattern": [{ "regexp": "^(psql:.+: ERROR: .+)$", "message": 1 }] },
    { "owner": "cp-spring-startup", "severity": "warning",
      "pattern": [{ "regexp": "^((?:Description|Action):\\s*.*|\\*+\\s*APPLICATION FAILED TO START.*)$", "message": 1 }] },
    { "owner": "cp-docker", "severity": "error",
      "pattern": [{ "regexp": "^(?:#\\d+ )?(ERROR: (?:failed to solve|process).+)$", "message": 1 }] }
  ]
}
