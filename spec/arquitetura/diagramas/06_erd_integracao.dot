 inbox [label="webhook_inbox
external_event_id único
assinatura · recebimento",shape=box];
 events [label="access_events
normalização sem inventar passagem",shape=box];
 out [label="outbox_events
mesma transação do negócio",shape=box];
 notify [label="notifications / ui_events
usuário · canal · confirmação",shape=box];
 audit [label="audit_events
ator · contexto · ação · evidência",shape=box];
 connector -> device [label="1:N"];connector -> cred [label="1:N"];cred -> sync [label="1:N"];device -> sync [label="1:N"];
 sync -> cmd;connector -> inbox;inbox -> events;events -> out;out -> notify;cmd -> audit;


