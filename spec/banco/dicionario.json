  {
    "name": "reservations",
    "description": "Reservas e bloqueios no mesmo mecanismo anti-conflito",
    "fields": [
      [
        "amenity_id",
        "uuid NOT NULL",
        "Área"
      ],
      [
        "unit_id",
        "uuid",
        "Unidade; obrigatória em BOOKING"
      ],
      [
        "created_by",
        "uuid NOT NULL REFERENCES platform.accounts(id)",
        "Ator"
      ],
      [
        "kind",
        "text NOT NULL DEFAULT 'BOOKING' CHECK (kind IN ('BOOKING','BLOCK'))",
        "Reserva ou manutenção"
      ],
      [
        "status",
        "text NOT NULL CHECK (status IN ('HELD','PENDING_APPROVAL','CONFIRMED','REJECTED','CANCELLED','EXPIRED'))",
        "Estado"
      ],
      [
        "starts_at",
        "timestamptz NOT NULL",
        "Início de uso"
      ],
      [
        "ends_at",
        "timestamptz NOT NULL",
        "Fim de uso"
      ],
      [
        "occupied_from",
        "timestamptz NOT NULL",
        "Início efetivo com buffer"
      ],
      [
        "occupied_until",
        "timestamptz NOT NULL",
        "Fim efetivo com buffer"
      ],
      [
        "expires_at",
        "timestamptz",
        "Expiração de hold/aprovação"
      ],
      [
        "rule_snapshot",
        "jsonb NOT NULL",
        "Regras aceitas"
      ],
      [
        "fee_cents",
        "bigint NOT NULL DEFAULT 0 CHECK (fee_cents >= 0)",
        "Taxa registrada"
      ],
      [
        "decision_reason",
        "text",
        "Motivo de decisão/cancelamento"
      ]
    ],
    "constraints": [
      "FOREIGN KEY (tenant_id, amenity_id) REFERENCES cp.amenities(tenant_id, id)",
      "FOREIGN KEY (tenant_id, unit_id) REFERENCES cp.units(tenant_id, id)",
      "CHECK (starts_at < ends_at AND occupied_from <= starts_at AND occupied_until >= ends_at)",
      "CHECK (kind <> 'BOOKING' OR unit_id IS NOT NULL)",
      "CHECK (status NOT IN ('HELD','PENDING_APPROVAL') OR expires_at IS NOT NULL)",
      "EXCLUDE USING gist (tenant_id WITH =, amenity_id WITH =, tstzrange(occupied_from, occupied_until, '[)') WITH &&) WHERE (status IN ('HELD','PENDING_APPROVAL','CONFIRMED'))"
    ],
    "indexes": [
      "CREATE INDEX reservations_unit_period ON cp.reservations(tenant_id,unit_id,starts_at);"
    ],
    "mutable": true
  },
