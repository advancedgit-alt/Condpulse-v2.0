<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <!-- Gateway de acesso facial do condomínio (AC-018..AC-033). Módulo separado do backend: não toca no banco central. -->
 <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.2</version><relativePath/></parent>
 <groupId>br.com.condpulse</groupId><artifactId>condpulse-access-gateway</artifactId><version>0.1.0-SNAPSHOT</version>
 <properties><java.version>25</java.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
 <dependencies>
  <!-- Só o núcleo do Spring Boot para o ciclo de vida; HTTP, JSON e diário usam apenas o JDK. -->
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
 </dependencies>
 <build>
  <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><mainClass>br.com.condpulse.gateway.app.GatewayApplication</mainClass></configuration></plugin></plugins>
 </build>
</project>
