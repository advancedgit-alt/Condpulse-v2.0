{
  "openapi": "3.1.0",
  "info": {
    "title": "CondPulse — API da fundação",
    "version": "0.1.0",
    "description": "Leitura inicial e BFF condicional CP_BFF_ENABLED; tokens Auth permanecem no servidor."
  },
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "currentIdentity",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "webSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Conta ativa e vínculos atuais do próprio ator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentIdentity"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Conta inativa ou ação negada"
          },
          "503": {
            "description": "Banco indisponível"
          }
        }
      }
    },
    "/auth/csrf": {
      "get": {
        "operationId": "csrfToken",
        "security": [],
        "x-feature-flag": "CP_BFF_ENABLED",
        "responses": {
          "200": {
            "description": "Cookie HttpOnly e token CSRF para cabeçalho",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "headerName",
                    "token"
                  ],
                  "properties": {
                    "headerName": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "x-feature-flag": "CP_BFF_ENABLED",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessão protegida; resposta sem tokens do provedor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accountId",
                    "expiresAt"
                  ],
                  "properties": {
                    "accountId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessão ou credencial inválida"
          },
          "403": {
            "description": "Origem ou CSRF inválido"
          },
          "409": {
            "description": "Renovação em andamento"
          },
          "429": {
            "description": "Limite de autenticação"
          },
          "503": {
            "description": "Provedor indisponível"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "security": [],
        "x-feature-flag": "CP_BFF_ENABLED",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessão protegida; resposta sem tokens do provedor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accountId",
                    "expiresAt"
                  ],
                  "properties": {
                    "accountId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessão ou credencial inválida"
          },
          "403": {
            "description": "Origem ou CSRF inválido"
          },
          "409": {
            "description": "Renovação em andamento"
          },
          "429": {
            "description": "Limite de autenticação"
          },
          "503": {
            "description": "Provedor indisponível"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [],
        "x-feature-flag": "CP_BFF_ENABLED",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sessão local invalidada"
          },
          "401": {
            "description": "Sessão ou credencial inválida"
          },
          "403": {
            "description": "Origem ou CSRF inválido"
          },
          "409": {
            "description": "Renovação em andamento"
          },
          "429": {
            "description": "Limite de autenticação"
          },
          "503": {
            "description": "Provedor indisponível"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "webSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-cp_session"
      }
    },
    "schemas": {
      "CurrentIdentity": {
        "type": "object",
        "required": [
          "accountId",
          "memberships"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "membershipId",
          "tenantId",
          "tenantName",
          "timeZone",
          "role",
          "unitId"
        ],
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantName": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "RESIDENT",
              "RESPONSIBLE",
              "DEPENDENT",
              "OWNER",
              "CONCIERGE",
              "MANAGER",
              "SUPPORT"
            ]
          },
          "unitId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      }
    }
  }
}
